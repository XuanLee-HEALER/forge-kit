{
  "name": "forge-kit",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "files": [
    "bin",
    "core",
    "dist/cli.js",
    "kit.toml",
    "review-agents/bin",
    "review-agents/dist/review.js",
    "review-agents/package.json",
    "review-agents/standalone/bun.lock",
    "review-agents/prompts",
    "review-agents/src",
    "templates",
    "review-agents/README.md",
    "review-agents/evals/quality.json",
    "review-agents/scripts",
    "review-agents/tests",
    "review-agents/tsconfig.json"
  ],
  "bin": {
    "forge": "./bin/forge"
  },
  "scripts": {
    "build": "bun scripts/build.ts && (cd review-agents && bun run build)",
    "check": "bun --bun run tsc --noEmit",
    "test": "bun test ./tests",
    "test:unit": "bun run test:all",
    "test:all": "bun scripts/test-all.ts",
    "forge": "bun src/bin/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "workspaces": [
    "review-agents"
  ]
}
