#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUN="${BUN_BIN:-$(command -v bun || echo "$HOME/.bun/bin/bun")}"
# Git checkouts use the current sources. Installed packages ship the Bun bundle.
if [[ -f "$ROOT/src/bin/cli.ts" ]]; then
  exec "$BUN" "$ROOT/src/bin/cli.ts" "$@"
fi
exec "$BUN" "$ROOT/dist/cli.js" "$@"
