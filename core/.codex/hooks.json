{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{WORKBENCH_ROOT}}/.workbench/bin/forge\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{WORKBENCH_ROOT}}/.workbench/bin/forge\" ledger-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{WORKBENCH_ROOT}}/.workbench/bin/forge\" ledger-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{WORKBENCH_ROOT}}/.workbench/bin/forge\" ledger-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{WORKBENCH_ROOT}}/.workbench/bin/forge\" ledger-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
